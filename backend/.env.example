# ─── ClipForge AI Environment Configuration ───────────────────────────────────

# App
DEBUG=false
SECRET_KEY=change-me-to-a-random-32-byte-string

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./clipforge.db
# DATABASE_URL=postgresql://user:password@localhost:5432/clipforge

# Redis (required for Celery task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
STORAGE_BASE=./storage
MAX_VIDEO_SIZE_MB=2000

# AI — Required for instruction parsing and viral scoring
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-4-6

# Processing
MAX_CONCURRENT_JOBS=2
